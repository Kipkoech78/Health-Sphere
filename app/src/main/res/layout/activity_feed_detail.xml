<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.feeds.FeedDetailActivity">
    <Toolbar
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:id="@+id/feedToolBar"
        android:background="@color/blue_1"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Healthy Living"
            android:gravity="center"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_thick"
            android:textStyle="bold"
            android:textSize="30sp"
            android:paddingTop="30dp"/>
    </Toolbar>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/feedToolBar"
        android:background="@drawable/women"
        >

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/feedToolBar"
        android:scrollbars="none">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/feedToolBar">

            <TextView
                android:id="@+id/feed_heading"
                android:layout_width="match_parent"
                android:paddingLeft="20dp"
                android:paddingRight="10dp"
                android:fontFamily="@font/poppins_thick"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:gravity="start"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"
                android:textStyle="bold"
                android:paddingBottom="8dp"
                android:text="Feed Heading" />

            <TextView
                android:id="@+id/feed_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_below="@id/feed_heading"
                android:fontFamily="@font/poppins_medium"
                android:gravity="start"
                android:textColor="@color/black"
                android:paddingLeft="20dp"
                android:paddingRight="10dp"
                android:text="Feed Description" />

        </RelativeLayout>
    </ScrollView>



</RelativeLayout>