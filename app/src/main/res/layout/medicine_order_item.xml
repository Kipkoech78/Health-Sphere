<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:background="@drawable/headerimg">

    <LinearLayout
        android:id="@+id/linearlayoutdesc"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:gravity="center|start"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/drugNameTextView"
            android:layout_width="0dp"
            android:layout_weight="0.70"
            android:layout_height="50dp"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_thick" />

        <TextView
            android:id="@+id/feesTextView"
            android:layout_width="0dp"
            android:layout_weight="0.30"
            android:layout_height="50dp"
            android:gravity="end"
            android:textSize="20sp"
            android:textColor="@color/textcolyellow" />
    </LinearLayout>

    <!-- Adjust or remove marginBottom here -->
    <LinearLayout
        android:id="@+id/dateTime"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/linearlayoutdesc"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="0dp"
            android:layout_weight="0.6"
            android:layout_height="50dp"
            android:gravity="start|center"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/timeTextView"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="50dp"
            android:gravity="end|center"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/orderId"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/dateTime" />
</RelativeLayout>
